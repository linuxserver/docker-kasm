#!/usr/bin/with-contenv bash

# Wait for docker to be up
while [[ ! -S /var/run/docker.sock ]]; do
    sleep 1
done

# Don't do anything if Kasm is installed and wizard is disabled via env or file
if [[ -f "/opt/kasm/.wizard_install_complete" ]]; then
  if [[ "${KASM_SETUP,,}" != 'true' ]] || [[ -f "/opt/NO_WIZARD" ]]; then
      echo "Kasm has already been installed and either KASM_SETUP is not set to 'true' or /opt/NO_WIZARD exists, disabling install wizard"
      sleep infinity
  fi
fi

cd /wizard || exit 1
/usr/bin/node index.js
